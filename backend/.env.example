# SwasthyaSaathi Environment Configuration

# Groq API Key for grounded LLM generation
GROQ_API_KEY=your_groq_api_key_here

# CORS: comma-separated list of allowed origins (use * for dev, your Vercel URL for prod)
# Example: https://swasthya-saathi.vercel.app,https://swasthyasaathi.vercel.app
ALLOWED_ORIGINS=*

# Vector Store Directory
VECTOR_STORE_DIR=./data/vector_store
RAW_DOCS_DIR=./data/raw_docs

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Server Port
PORT=8000

# --- FRONTEND (Vite) ---
# Set in Vercel Dashboard > Project > Environment Variables
VITE_API_BASE_URL=https://swasthya-saathi-backend.onrender.com
