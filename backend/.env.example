# SwasthyaSaathi Environment Configuration

# Groq API Key for grounded LLM generation
GROQ_API_KEY=your_groq_api_key_here

# CORS: comma-separated list of allowed origins (use * for dev, your Vercel URL for prod)
# Example: https://swasthya-saathi.vercel.app,https://swasthyasaathi.vercel.app
ALLOWED_ORIGINS=*
GATE_FAISS_FLOOR=0.45
GATE_GLOBAL_THRESHOLD=-9.5
GATE_MIN_CLUSTER_SAMPLES=12
INTEGRITY_MODE=warn
ADMIN_TOKEN=
GAPS_HASH_SALT=replace-with-a-long-random-secret
HELPLINE_REFERRAL_TEXT=Please contact a qualified clinician or your local public-health service.
EMERGENCY_NUMBER=112
MENTAL_HEALTH_HELPLINE=14416
WEB_ALLOWED_HOSTS=who.int,mohfw.gov.in,icmr.gov.in,nhp.gov.in,nhm.gov.in,cdc.gov,nhs.uk,medlineplus.gov,nih.gov
WEB_CACHE_TTL_SECONDS=3600
ENABLE_CONTENT_VERIFIER=true
DATABASE_URL=

# Vector Store Directory
VECTOR_STORE_DIR=./data/vector_store
RAW_DOCS_DIR=./data/raw_docs

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Server Port
PORT=8000

# --- FRONTEND (Vite) ---
# Set in Vercel Dashboard > Project > Environment Variables
VITE_API_BASE_URL=https://swasthya-saathi-backend.onrender.com
