# SwasthyaSaathi Environment Configuration

# Groq API Key for grounded LLM generation
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL database connection string (Neon / Render / Local)
# Example Neon: postgresql://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/swasthya_db?sslmode=require
DATABASE_URL=sqlite:///./swasthya.db

# Vector Store Directory
VECTOR_STORE_DIR=./data/vector_store
RAW_DOCS_DIR=./data/raw_docs

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Server Port
PORT=8000
